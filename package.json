{
  "name": "devmemory-monorepo",
  "version": "0.2.0",
  "private": true,
  "description": "DevMemory MCP - universal persistent AI development intelligence platform",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "typecheck": "tsc -b --pretty",
    "test": "vitest run",
    "test:watch": "vitest",
    "devmemory": "node --experimental-sqlite --no-warnings apps/cli/dist/bin.js",
    "release": "pnpm build && pnpm test && pnpm -r publish --access public"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@types/node": "^24.10.0",
    "pino": "^10.3.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "zod": "^4.5.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wabmetacontact-svg/devmemory.git"
  }
}
